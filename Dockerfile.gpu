# First GPU qualification must use this exact torch/torchvision pair.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 HF_HOME=/workspace/cache/huggingface WORKER_DIR=/workspace/maymay MUSUBI_ROOT=/opt/musubi HF_HUB_DISABLE_XET=1
RUN apt-get update && apt-get install -y --no-install-recommends python3.12 python3.12-venv git ffmpeg libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
RUN pip install --no-cache-dir torch==2.10.0 torchvision==0.25.0 --index-url https://download.pytorch.org/whl/cu128
COPY constraints-gpu.txt /opt/constraints-gpu.txt
RUN git clone https://github.com/kohya-ss/musubi-tuner.git /opt/musubi && cd /opt/musubi && git checkout f8a1b03794a49239a3539015075f5123d6c07d66 && pip install --no-cache-dir -c /opt/constraints-gpu.txt .
WORKDIR /opt/studio
COPY requirements.txt ./
RUN pip install --no-cache-dir -c /opt/constraints-gpu.txt -r requirements.txt
COPY maymay/ ./maymay/
COPY agent/ ./agent/
COPY scripts/doctor.py ./scripts/doctor.py
RUN python -c "import torch, torchvision, diffusers, transformers; from torchvision.ops import nms; from transformers import Qwen2_5_VLForConditionalGeneration; print(torch.__version__, torchvision.__version__)" && pip check
CMD ["python","-m","agent.main"]
