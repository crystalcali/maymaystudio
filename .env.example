# Production: replace all CHANGE_ME values. Never commit .env.
STUDIO_ENV=production
PUBLIC_URL=https://CHANGE_ME.timeweb.cloud
ADMIN_PASSWORD=CHANGE_ME_LONG_PASSWORD
SECRET_KEY=CHANGE_ME_RANDOM_PERSISTENT_SECRET_AT_LEAST_32_CHARS
DATABASE_URL=postgresql+psycopg://studio:CHANGE_ME@DATABASE_HOST:5432/maymay?sslmode=require
S3_ENDPOINT_URL=https://s3.timeweb.cloud
S3_REGION=ru-1
S3_BUCKET=CHANGE_ME_PRIVATE_BUCKET
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AGENT_IMAGE=ghcr.io/CHANGE_ME/maymay-studio-3-gpu:latest
# Tokens may instead be entered in the authenticated Settings screen.
YOUGPU_API_KEY=
HF_TOKEN=
CIVITAI_TOKEN=
PORT=8000
MAX_UPLOAD_MB=1024
